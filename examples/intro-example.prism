mdp

module host
	h : [0..7] init 0;
	[a0] h = 0 -> 0.25 : (h'=1) + 0.25 : (h'=2) + 0.5 : (h'=7);
	[a01] h = 0 -> 1 : (h'=5);
	//[a7] h = 0 -> 1 : (h'=7);
	[a1] h = 1 -> 1 : (h'=3);
	[a11] h = 1 -> 1 : (h'=0);
	[a2] h = 2 -> 1 : (h'=4);
	[a3] h = 3 -> 0.5 : (h'=5) + 0.5 : (h'=6);
	[a4] h = 4 -> 0.25 : (h'=5) + 0.75 : (h'=6);
	[a5] h = 5 -> (h'=5);
	[a6] h = 6 -> (h'=6);
	[a8] h = 7 -> 0.25 : (h'=5) + 0.75 : (h'=6);
endmodule